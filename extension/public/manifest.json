{
  "manifest_version": 3,
  "name": "WhyNavo - Local-first New Tab",
  "short_name": "WhyNavo",
  "description": "A local-first new tab dashboard for shortcuts, widgets, notes, todos, weather, and optional sync.",
  "version": "0.9.29",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "alarms",
    "storage",
    "search"
  ],
  "optional_permissions": [
    "geolocation",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://api.pwnedpasswords.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://keafulupzvfljvbzwgrq.supabase.co/*",
    "https://whynavo.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-src https://whynavo.com"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
