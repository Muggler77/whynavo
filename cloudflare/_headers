/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://keafulupzvfljvbzwgrq.supabase.co https://api.open-meteo.com https://api.pwnedpasswords.com https://geocoding-api.open-meteo.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/wallpapers/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/latest-version.json
  Cache-Control: public, max-age=60, must-revalidate

# Browsers perform byte-level Service Worker update checks. Never let an edge
# cache pair a new app shell with the previous release's worker script.
/sw.js
  Cache-Control: no-store

/captcha.html
  ! Content-Security-Policy
  ! Cross-Origin-Resource-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' chrome-extension:; upgrade-insecure-requests
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=300, must-revalidate

# Cloudflare Pages canonicalizes .html routes to extensionless URLs. Keep the
# final CAPTCHA response embeddable by the official extension as well.
/captcha
  ! Content-Security-Policy
  ! Cross-Origin-Resource-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' chrome-extension:; upgrade-insecure-requests
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=300, must-revalidate

/captcha.js
  Cache-Control: public, max-age=300, must-revalidate

/captcha.css
  Cache-Control: public, max-age=300, must-revalidate

/confirm.html
  Cache-Control: no-store

# The canonical confirmation route must retain the same token-leakage control.
/confirm
  Cache-Control: no-store

/confirm.js
  Cache-Control: public, max-age=300, must-revalidate

/confirm.css
  Cache-Control: public, max-age=300, must-revalidate
